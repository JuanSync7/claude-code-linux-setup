# Monday morning, before anyone asks.
#
# 07:15 is offset from the daily health check (06:30 + up to 15m of jitter) so
# that two failed units are distinguishable in `systemctl --failed` by their
# timestamps rather than by guesswork.
#
# Persistent=true: a host that was down over the weekend runs the missed check on
# next boot instead of silently skipping a week. RandomizedDelaySec spreads the
# fleet so its hosts do not all hit the vendor at the same second.

[Unit]
Description=Run the Claude Code version watch weekly

[Timer]
OnCalendar=Mon *-*-* 07:15:00
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
