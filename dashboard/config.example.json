{
  "store": "/var/lib/fleetdash/store.db",
  "host_label": "dashboard host",
  "bind": "127.0.0.1",
  "port": 8765,
  "transcript_glob": "/home/*/.claude/projects",
  "user_from_path": "/home/([^/]+)/",
  "hook_log_dir": "/var/log/claude-code",
  "admin_log": "",
  "spool": "",
  "feed": {"transcripts": "~/.claude/projects", "state_dir": "~/.claude/fleetdash"},
  "token_file": "",
  "claude_bin": "/usr/bin/claude",
  "policy": {"deployed": "/etc/claude-code/managed-settings.json", "source": ""},
  "host_stale_hours": 72,
  "drift": {"report": "/var/log/claude-code/drift.json", "max_age_hours": 48},
  "docs": [],
  "actions": [],
  "runs": {"dir": "/var/lib/fleetdash/runs", "keep": 50},
  "install": {"account": "", "python": "/usr/bin/python3", "code_dir": "/usr/local/share/fleetdash",
              "config_file": "/etc/fleetdash/config.json", "units_dir": "/etc/systemd/system",
              "ingest_interval": "5min", "prune_calendar": "daily"},
  "verify_file_owner": true,
  "bedrock_id_prefix": "msg_bdrk_",
  "bedrock_model_pattern": "^(?:(?:[a-z]{2,4}\\.)?anthropic\\.|arn:aws:bedrock:)",
  "prices_per_mtok": {},
  "seats": [],
  "under_use": {"idle_days": 14, "median_fraction": 0.1},
  "retention": {
    "pass":   {"days": 14,  "max_rows": 500000},
    "info":   {"days": 90,  "max_rows": 200000},
    "deny":   {"days": 365, "max_rows": 200000},
    "redact": {"days": 365, "max_rows": 200000},
    "quota":  {"days": 365, "max_rows": 200000},
    "error":  {"days": 180, "max_rows": 200000}
  }
}
